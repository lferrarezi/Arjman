{
  "manifest_version": 3,
  "name": "Arjman Compression",
  "version": "1.1.2",
  "description": "Reduza seus tokens em 40% com a compressão Arjman diretamente no ChatGPT, Claude e Gemini.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://*.gemini.google.com/*",
    "*://api.openai.com/*",
    "*://api.groq.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurar Arjman"
  }
}
